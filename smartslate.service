[Unit]
Description=SmartSlate Education Platform — Raspberry Pi 2 W Master Service
Documentation=https://github.com/smartslate
After=network.target network-online.target NetworkManager.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/smartslate
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=0.0.0.0
Environment=STUDENT_SERVER_URL=http://10.42.0.1:3000
ExecStart=/usr/bin/node --max-old-space-size=256 /home/pi/smartslate/smartslate-pi-master.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smartslate

# Security & Sandboxing for Raspberry Pi OS
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/pi/smartslate/shared/db /home/pi/smartslate/5thbelow/data /home/pi/smartslate/6to10th/student/data /home/pi/smartslate/intermediate/data /home/pi/smartslate/btech/data /home/pi/smartslate/parent-teacher/data

[Install]
WantedBy=multi-user.target
