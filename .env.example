# SmartSlate Environment Configuration Template

# Server Port Settings
PORT=3001

# Configurable Student Server URL
# Laptop Local Dev: http://localhost:3000
# Raspberry Pi Production: http://10.42.0.1:3000
STUDENT_SERVER_URL=http://localhost:3000

# Firebase Web App Credentials
